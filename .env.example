# Use absolute host paths when these directories are outside the repository.
GEDICORRECT_ALS_DIR=./data/als
GEDICORRECT_INPUT_DIR=./data/input
GEDICORRECT_OUTPUT_DIR=./data/output
GEDICORRECT_PORT=8501
GEDICORRECT_CPUS=8.0
GEDICORRECT_MEMORY=16g
GEDICORRECT_SHM_SIZE=2g
# Linux users can set these to the output of `id -u` and `id -g`.
GEDICORRECT_UID=10001
GEDICORRECT_GID=10001
